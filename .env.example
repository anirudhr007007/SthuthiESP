# Copy this file to .env and adjust only what you need.
#
# .env is loaded automatically and is git-ignored. Real environment variables
# always win over values in this file. Never put real API keys in source code,
# screenshots, training folders, app.txt, or api.txt.
#
# Safe default: camera + face recognition + speech output, microphone off,
# verified local FAQ answers, and optional local Ollama for general questions.

# ---------------------------------------------------------------------------
# College and data locations (relative paths are resolved from the project)
# ---------------------------------------------------------------------------
COLLEGE_NAME=Malnad College of Engineering, Hassan
TRAINING_PATH=data/training_images
KNOWLEDGE_PATH=data/college_knowledge.json
EMBEDDING_CACHE_PATH=.cache/embeddings.json
USE_EMBEDDING_CACHE=true
# Root for pip, temporary, DeepFace, Whisper, Keras, and tool caches.
ESSPTHUTHI_RUNTIME_DIR=.runtime

# ---------------------------------------------------------------------------
# Face recognition and camera
# ---------------------------------------------------------------------------
FACE_MODEL=VGG-Face
FACE_DETECTOR=opencv
SIMILARITY_THRESHOLD=0.68
MATCH_MARGIN=0.08
RECOGNITION_INTERVAL=0.35
RECOGNITION_RESULT_MAX_AGE=1.5
MAX_FRAME_WIDTH=640
IDENTITY_CONFIRMATIONS=3
CAMERA_INDEX=0
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=30
CAMERA_BUFFER_SIZE=1
CAMERA_READ_RETRIES=5
CAMERA_MAX_READ_FAILURES=10

# ---------------------------------------------------------------------------
# Voice input (opt-in). Keep STT_PROVIDER=none unless you need a microphone.
# google sends audio to Google; whisper keeps audio local.
# ---------------------------------------------------------------------------
ENABLE_VOICE=true
STT_PROVIDER=none
STT_LANGUAGE=en-IN
# STT_DEVICE_INDEX=
# STT_ENERGY_THRESHOLD=
STT_PAUSE_THRESHOLD=0.8
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
LISTEN_TIMEOUT=1.0
PHRASE_TIME_LIMIT=8
WAKE_WORD=
ECHO_GUARD=true
ECHO_SIMILARITY_THRESHOLD=0.72
ECHO_IDLE_GRACE=0.6
ECHO_RECENT_WINDOW=20.0
# Print heard questions/answers in the terminal (visitor privacy risk);
# enable only while tuning the microphone, wake word, or echo guard.
VOICE_DEBUG=false

# ---------------------------------------------------------------------------
# Speech output and greeting behaviour
# ---------------------------------------------------------------------------
SPEECH_OUTPUT=
SPEECH_VOICE=
SPEECH_RATE=165
SPEECH_VOLUME=1.0
SPEECH_QUEUE_SIZE=25
STARTUP_SPEECH=true
GREETING_MIN_GAP=2.0
PRESENCE_TIMEOUT=8.0
VISITOR_WELCOME_COOLDOWN=20.0

# ---------------------------------------------------------------------------
# Answer provider. ollama is local and free. offline disables all cloud calls.
# Ollama's model store is managed by the Ollama server; see docs/operations.md
# for a project-local OLLAMA_MODELS setup.
# ---------------------------------------------------------------------------
AI_PROVIDER=ollama
AI_TIMEOUT=15
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# Optional cloud providers. Leave keys empty unless you opt in.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=

# NVIDIA NIM hosted models: set AI_PROVIDER=nvidia, put your "nvapi-..." key
# in AI_API_KEY and a live build.nvidia.com chat model id in AI_MODEL
# (2026-11 example: nvidia/nemotron-3.5-lightning-30b-a3b). Older catalogue
# ids age out with HTTP 410 end-of-life responses, so re-check
# build.nvidia.com from time to time. With AI_BASE_URL empty the hosted
# endpoint https://integrate.api.nvidia.com/v1 is used automatically.
# See docs/configuration.md.

# Optional OpenAI-compatible HTTPS endpoint (or loopback LM Studio).
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Cloud spend guard. Applies only to remote providers, never local Ollama.
CLOUD_MIN_INTERVAL=3.0
CLOUD_MAX_CALLS_PER_HOUR=60
PROVIDER_PROBE_TIMEOUT=3.0

# Optional DuckDuckGo context for general questions. The question text is sent
# to DuckDuckGo while this is true; set false for a strictly no-search demo.
WEB_SEARCH=true
